          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 200,
            "body": {
              "id": "one",
              "value": "updated"
            }
          }
        },
        {
          "method": "GET",
          "path": "/items/one",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 200,
            "body": {
              "id": "one",
              "value": "updated"
            }
          }
        },
        {
          "method": "DELETE",
          "path": "/items/two",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 200,
            "body": {
              "deleted": "two"
            }
          }
        },
        {
          "method": "GET",
          "path": "/items/two",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 404,
            "body": {
              "error": "not_found"
            }
          }
        },
        {
          "method": "DELETE",
          "path": "/items/two",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 404,
            "body": {
              "error": "not_found"
            }
          }
        },
        {
          "method": "GET",
          "path": "/items?offset=abc&limit=1",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 400,
            "body": {
              "error": "invalid_pagination"
            }
          }
        },
        {
          "method": "GET",
          "path": "/items/one",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 200,
            "body": {
              "id": "one",
              "value": "updated"
            }
          }
        },
        {
          "method": "GET",
          "path": "/items/one",
          "body": null,
          "expected": {
            "status": 401,
            "body": {
              "error": "unauthorized"
            }
          }
        },
        {
          "method": "POST",
          "path": "/items",
          "body": {
            "op": "revoke"
          },
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 200,
            "body": {
              "ok": true
            }
          }
        },
        {
          "method": "GET",
          "path": "/items/one",
          "body": null,
          "headers": {
            "Authorization": "Bearer fixture-token-alpha"
          },
          "expected": {
            "status": 401,
            "body": {
              "error": "revoked"
            }
          }
        }
      ]
    }
  ]
}
